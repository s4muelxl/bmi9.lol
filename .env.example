# Copie este arquivo para .env e preencha com as suas configuracoes locais/producao.
# NUNCA envie seu arquivo .env com credenciais reais para o repositorio publico.

# Configurações de Atendimento e Notificação
BMI9_EMAIL_DESTINO=contato@seudominio.com
BMI9_WHATSAPP_NUMBER=5511999999999

# Token de Administracao (obrigatorio para acessar rotas restritas como /admin/leads)
BMI9_ADMIN_TOKEN=defina_um_token_seguro_aqui

# Configuracao de Envio via SMTP (Gmail ou outro provedor)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=COLE_AQUI_A_SENHA_DE_APP

# Configuracao de Envio via Resend API (Opcional / Producao)
RESEND_API_KEY=re_COLE_AQUI_SUA_CHAVE_RESEND
RESEND_FROM=orcamentos@seudominio.com

# Configuracao de Armazenamento Redis / Vercel KV (Opcional para persistencia de likes/comentarios)
# REDIS_URL=redis://default:senha@host:porta
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
